{
  "manifest_version": 3,
  "key": "",
  "name": "Jasmine Chrome Control",
  "version": "0.1.0",
  "description": "Lets the Jasmine desktop app operate your real Chrome tabs with your existing session.",
  "permissions": ["debugger", "tabs", "nativeMessaging", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jasmine Chrome Control"
  }
}
