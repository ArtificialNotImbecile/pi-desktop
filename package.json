{
  "name": "pi-desktop",
  "version": "0.3.2",
  "description": "Jasmine — an independent desktop GUI for the Pi coding agent.",
  "author": "ArtificialNotImbecile",
  "desktopName": "ai.jasmine.desktop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtificialNotImbecile/pi-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/ArtificialNotImbecile/pi-desktop/issues"
  },
  "homepage": "https://github.com/ArtificialNotImbecile/pi-desktop#readme",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run build:context-capture && npm run build:file-changes && npm run build:permission-gate && npm run typecheck && vite build && tsc -p tsconfig.main.json",
    "build:context-capture": "npm --prefix src/main/agent/extensions/contextCapture run build",
    "build:file-changes": "npm --prefix src/main/agent/extensions/fileChanges run build",
    "build:permission-gate": "npm --prefix src/main/agent/extensions/permissionGate run build",
    "harness:check": "node scripts/check-ui-harness.mjs && npm run lint:ui",
    "harness:inspect": "node scripts/inspect-ui-harness.mjs",
    "harness:accept": "node scripts/run-ui-acceptance.mjs",
    "harness:release": "npm run harness:full && npm run harness:accept && node scripts/check-ui-release-gates.mjs",
    "harness:visual": "node scripts/capture-ui-matrix.mjs",
    "harness:full": "npm run build && npm run test:unit && npm run harness:inspect && npm run harness:visual && npm run harness:check && npm run test:e2e",
    "test:e2e": "cross-env JASMINE_E2E_OFFSCREEN=1 playwright test -c tests/playwright.config.ts",
    "test:e2e:bg": "npm run test:e2e",
    "test:e2e:smoke": "cross-env JASMINE_E2E_OFFSCREEN=1 playwright test -c tests/playwright.config.ts --grep @smoke",
    "test:e2e:full": "npm run test:e2e",
    "test:e2e:headed": "cross-env JASMINE_E2E_OFFSCREEN= playwright test -c tests/playwright.config.ts --headed",
    "test:context-capture": "npm run build:context-capture && node --no-warnings scripts/smoke-context-capture-package.mjs",
    "test:file-changes": "npm --prefix src/main/agent/extensions/fileChanges test",
    "test:startup-bootstrap": "node --no-warnings tests/unit/startup-bootstrap-smoke.mjs",
    "test:icon-assets": "node --no-warnings tests/unit/icon-assets-smoke.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "lint:ui": "node scripts/check-ui-primitives.mjs && node scripts/check-theme-colors.mjs",
    "verify": "npm run build && npm run test:unit && npm run harness:inspect && npm run harness:check && npm run test:e2e",
    "readme:capture": "npm run build && node scripts/capture-readme-gallery.mjs && node scripts/record-context-taxonomy-gif.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "test:packaged": "node scripts/smoke-packaged-app.mjs",
    "import:pi-sessions": "node --no-warnings scripts/import-pi-sessions.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@floating-ui/react": "^0.27.19",
    "@lexical/react": "^0.45.0",
    "@parcel/watcher": "2.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/transformers": "^4.2.0",
    "@shikijs/twoslash": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.193",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "electron-updater": "6.8.9",
    "lexical": "^0.45.0",
    "motion": "^12.40.0",
    "node-pty": "^1.1.0",
    "pi-web-access": "^0.10.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ai.jasmine.desktop",
    "productName": "Jasmine",
    "copyright": "Copyright © 2026 ArtificialNotImbecile",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/prebuilds/**"
    ],
    "afterPack": "./scripts/after-pack.mjs",
    "npmRebuild": false,
    "directories": {
      "output": "release/v${version}"
    },
    "publish": {
      "provider": "github",
      "owner": "ArtificialNotImbecile",
      "repo": "pi-desktop"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "src/main/preload.cjs"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "jasmine-resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/jasmine-logo-desktop.ico",
      "artifactName": "Jasmine-Setup-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/jasmine-logo.png",
      "category": "Development",
      "synopsis": "The desktop app for Pi",
      "maintainer": "ArtificialNotImbecile <10048576+ArtificialNotImbecile@users.noreply.github.com>",
      "executableName": "jasmine",
      "syncDesktopName": true,
      "artifactName": "Jasmine-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/jasmine-logo.png",
      "artifactName": "Jasmine-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
